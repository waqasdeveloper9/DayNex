{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "IdentityServiceDb": "Server=tcp:<your-azure-sql-server>.database.windows.net,1433;Initial Catalog=DayNexIdentityDb;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "EntraExternalId": {
    "Instance": "https://<your-tenant-name>.ciamlogin.com/",
    "TenantId": "<your-tenant-id>",
    "Authority": "https://<your-tenant-name>.ciamlogin.com/<your-tenant-id>/v2.0",
    "Audience": "<your-api-app-registration-client-id>"
  },

  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200" ]
  },

  "SuperAdmin": {
    "ExternalId": "<entra-oid-of-owner-account>",
    "Email": "owner@daynex.com",
    "DisplayName": "Waqas (Owner)"
  }
}
