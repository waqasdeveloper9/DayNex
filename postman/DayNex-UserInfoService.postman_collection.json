{
  "info": {
    "name": "DayNex UserInfoService \u2014 vehicles, companies and council",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run after creating the Vehicle database and applying the reviewed migrations. User identity is derived from the bearer token; never send userId. Company API integration and insurance data are not implemented."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Gateway health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway_url}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Healthy\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Assets reject missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway_url}}/api/assets/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unauthorized\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Load or create own Identity profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway_url}}/api/identity/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Profile\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Skip optional personal details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/identity/me/preferences",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postcode\": \"\",\n  \"holidayRegion\": \"EnglandAndWales\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Skipped\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().onboardingCompleted).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Read own saved references",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway_url}}/api/assets/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Own references\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().vehicles).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Add first vehicle - replace test registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/assets/me/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"AB12CDE\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reference saved\", () => { pm.response.to.have.status(200); pm.environment.set(\"vehicle_id\", pm.response.json().id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Repeat add is idempotent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/assets/me/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"AB12CDE\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Same reference\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"vehicle_id\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Add second vehicle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/assets/me/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"XY12ZZZ\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Saved\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Add company and retrieve its public profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/assets/me/companies",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyNumber\": \"SC123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Company reference saved\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Refresh vehicle after five minute cooldown",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{gateway_url}}/api/assets/me/vehicles/{{vehicle_id}}/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Success or cooldown\", () => pm.expect([200,429]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Invalid registration rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/api/assets/me/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"../invalid\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Bad request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Delete own vehicle",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{gateway_url}}/api/assets/me/vehicles/{{vehicle_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Deleted\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 MOT history for own vehicle",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/api/assets/me/vehicles/{{vehicle_id}}/mot?page=1&pageSize=20"
      }
    },
    {
      "name": "14 Scheduled vehicle refresh \u2014 direct UserInfoService URL",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "X-DayNex-Job-Key",
            "value": "{{vehicle_refresh_key}}"
          }
        ],
        "url": "{{userinfo_url}}/internal/jobs/vehicles/refresh",
        "description": "Direct VehicleService HTTPS URL when hosted. Requires enabled job, migrations and separate job key. Never use a customer access token here."
      }
    },
    {
      "name": "15 Onboarding \u2014 only supplied references are enriched",
      "request": {
        "method": "POST",
        "url": "{{gateway_url}}/api/assets/me/onboarding",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postcode\": \"{{postcode}}\",\n  \"vehicleRegistrations\": [],\n  \"companyNumbers\": [\n    \"{{company_number}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Saved\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json(); if (data.companies?.length) pm.environment.set(\"company_id\", data.companies[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Get saved company profile",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/api/assets/me/companies/{{company_id}}",
        "header": []
      }
    },
    {
      "name": "17 Refresh company \u2014 five minute cooldown",
      "request": {
        "method": "POST",
        "url": "{{gateway_url}}/api/assets/me/companies/{{company_id}}/refresh",
        "header": []
      }
    },
    {
      "name": "18 Set or change postcode and resolve council",
      "request": {
        "method": "PUT",
        "url": "{{gateway_url}}/api/assets/me/location",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postcode\": \"{{postcode}}\"\n}"
        }
      }
    },
    {
      "name": "19 Read saved postcode and council",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/api/assets/me/location",
        "header": []
      }
    },
    {
      "name": "20 Clear postcode and remove council association",
      "request": {
        "method": "PUT",
        "url": "{{gateway_url}}/api/assets/me/location",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postcode\": \"\"\n}"
        }
      }
    },
    {
      "name": "21 Provider DIRECT \u2014 Companies House Basic API key",
      "request": {
        "method": "GET",
        "url": "https://api.company-information.service.gov.uk/company/{{company_number}}",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{companies_house_api_key}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "22 Provider DIRECT \u2014 GOV.UK council, no authentication",
      "request": {
        "method": "GET",
        "url": "https://www.gov.uk/api/local-authority?postcode={{postcode}}",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
